NODE_ENV=development
SERVICE_NAME=marketplace-backend
LOG_LEVEL=info

HOST=0.0.0.0
PORT=3000
HTTP_TRUST_PROXY=false
HTTP_BODY_LIMIT=1mb
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
SWAGGER_ENABLED=true
# When true, seller publish submits a Product for admin approval instead of publishing immediately.
PRODUCT_MODERATION_REQUIRED=false
REVIEW_MODERATION_REQUIRED=false
# Development may use false. Production startup requires COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.example.com

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketplace
DB_POOL_MAX=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_APPLICATION_NAME=marketplace-backend

REDIS_URL=redis://localhost:6379
BULLMQ_PREFIX=marketplace
JOB_DEFAULT_ATTEMPTS=5
JOB_BACKOFF_MS=1000
JOB_DEFAULT_CONCURRENCY=5

# Use a long random secret in real environments.
JWT_ACCESS_SECRET=replace-this-with-at-least-32-random-characters
# Required in production. Used only by trusted /api/v1/internal/* service commands.
INTERNAL_API_KEY=replace-this-with-a-separate-32-character-internal-key
JWT_ISSUER=marketplace-api
JWT_AUDIENCE=marketplace-web
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_BYTES=48
REFRESH_TOKEN_TTL_SECONDS=2592000
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# One-time initial administrator bootstrap. Leave unset during normal runtime.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
# BOOTSTRAP_ADMIN_DISPLAY_NAME=Initial Platform Administrator

# Module 10 short-lived quote and reservation-attempt windows.
CHECKOUT_QUOTE_TTL_SECONDS=900
CHECKOUT_ATTEMPT_TTL_SECONDS=900
IDEMPOTENCY_LOCK_SECONDS=60
IDEMPOTENCY_RETENTION_SECONDS=86400
OUTBOX_BATCH_SIZE=100
OUTBOX_CLAIM_SECONDS=60
OUTBOX_BASE_RETRY_DELAY_MS=1000
OUTBOX_MAX_RETRY_DELAY_MS=300000

STORAGE_BUCKET=marketplace-dev
STORAGE_PROVIDER=s3_compatible
STORAGE_REGION=auto
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_SIGNED_URL_TTL_SECONDS=900

# Module 21 deployment policy. Empty {} fails closed: no upload purpose is enabled.
# Example shape only; choose MIME types and byte limits for your deployment requirements.
# Module 6 Product media uses the product_media purpose; keep only MIME types your storefront supports.
# Shape: {"product_media":{"allowedMimeTypes":["image/jpeg","image/png","image/webp"],"maxSizeBytes":<deployment-byte-limit>},"seller_verification":{"allowedMimeTypes":["<deployment-mime-type>"],"maxSizeBytes":<deployment-byte-limit>},"store_asset":{"allowedMimeTypes":["<deployment-mime-type>"],"maxSizeBytes":<deployment-byte-limit>}}
DOCUMENT_UPLOAD_POLICY_JSON={}
# Module 12 Stripe sandbox/test integration. Keep these values backend-only.
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Explicit provider minor-unit exponents for Administration-supported currencies.
STRIPE_CURRENCY_EXPONENTS_JSON={"USD":2,"PKR":2}


# Module 17 payout-provider composition. Production requires mode=module and a deployment-owned adapter module.
# The module must default-export a PayoutProviderAdapter or export createPayoutProviderAdapter().
PAYOUT_PROVIDER_MODE=unconfigured
# PAYOUT_PROVIDER_TYPE=your_provider_code
# PAYOUT_PROVIDER_ADAPTER_MODULE=/app/providers/your-payout-provider.js
# Test/E2E only; production rejects a non-zero value.
WALLET_PAYOUT_TEST_CLOCK_OFFSET_DAYS=0

# Module 18 email delivery. Use "resend" with the two values below in a real email-enabled environment.
NOTIFICATION_EMAIL_PROVIDER_MODE=disabled
# NOTIFICATION_EMAIL_FROM=notifications@example.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
# RESEND_API_BASE_URL=http://localhost:9999
