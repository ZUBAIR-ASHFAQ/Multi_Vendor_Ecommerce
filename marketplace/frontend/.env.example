# Browser-visible API configuration only. Never put secrets in VITE_* values.
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_APP_NAME=Marketplace
# Browser-safe Stripe key is REQUIRED. Never place sk_* or webhook secrets in VITE_* variables.
# Replace this placeholder in .env.local with the pk_test_* key paired with your backend Stripe test account.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Optional local-development helper. START_MARKETPLACE.ps1 sets this to true when it enables
# deterministic payout/email providers. It is browser-visible and contains no credentials.
VITE_LOCAL_DEMO_PROVIDERS=false
